{
  "version": 2,
  "name": "edu-discover-frontend",
  "buildCommand": "cd artifacts/college-discovery && pnpm install && pnpm run build",
  "outputDirectory": "artifacts/college-discovery/dist/public",
  "installCommand": "pnpm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://edu-discover-api.onrender.com/api/$1"
    }
  ],
  "env": {
    "VITE_API_URL": "https://edu-discover-api.onrender.com"
  }
}
